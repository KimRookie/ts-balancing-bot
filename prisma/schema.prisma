generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  nickname  String   @id
  score     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchWins  Match[] @relation("WinnerPlayers")
  matchLoses Match[] @relation("LoserPlayers")
}

model Match {
  id        Int      @id @default(autoincrement())
  guildId   String
  mode      String
  createdAt DateTime @default(now())

  winners    Player[] @relation("WinnerPlayers")
  losers     Player[] @relation("LoserPlayers")
}